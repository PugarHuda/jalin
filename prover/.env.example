# Copy to .env. Never commit the real file.

# Starknet mainnet RPC. Create a free key at https://www.alchemy.com
STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Optional. Only needed for live indexing; discovery works without it.
STARKNET_WS_URL=

# The STRK20 pool on mainnet.
POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# Screening endpoint the interceptor posts to. Without it the sidecar is a
# no-op pass-through that always allows, and /health still reports OK.
SCREENING_URL=

DISCOVERY_PORT=8081
INTERCEPTOR_PORT=8082
RUST_LOG=info
