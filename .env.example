# Copy to .env and fill in. Never commit the real file - .gitignore covers it.

# Starknet mainnet. Free key at https://www.alchemy.com
# Versioned path: the default /v2/<key> serves RPC 0.8.1, which sncast rejects.
STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_10/YOUR_ALCHEMY_KEY

# The STRK20 pool on mainnet.
POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# Deployer. Needs enough STRK for two declares and two deploys.
ACCOUNT_ADDRESS=
ACCOUNT_PRIVATE_KEY=
ACCOUNT_TYPE=oz

# Governance. BALLOT_TOKEN is what a vote is denominated in; on mainnet that is
# STRK unless you have a reason for something else.
BALLOT_TOKEN=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
FEE_RECIPIENT=

# Router limits at deploy. Governance can move these afterwards.
MAX_STEPS=8
MAX_CALLDATA=64

# Roughly 8 hours of voting and 2 hours of timelock at mainnet block times.
VOTING_BLOCKS=2000
TIMELOCK_BLOCKS=500
# 1 STRK, in wei.
QUORUM=1000000000000000000

# Written back here by contracts/deploy.sh once the contracts are on chain, and
# read afterwards by every script and by the web app. The app inlines the two
# NEXT_PUBLIC_ copies at build time, which is why playwright.config.ts maps
# these into the build it starts.
ROUTER_ADDRESS=
GOVERNOR_ADDRESS=

# The web app. NEXT_PUBLIC_ values are baked into the client bundle at build
# time, so only put addresses here - never a key.
NEXT_PUBLIC_ROUTER_ADDRESS=
NEXT_PUBLIC_GOVERNOR_ADDRESS=
# Absolute origin, used for the Open Graph card, robots.txt and sitemap.xml.
# Defaults to the deployed site when unset.
NEXT_PUBLIC_SITE_URL=https://jalin-five.vercel.app

# scripts/mainnet.mjs only. A hosted mainnet prover answers at the URL below;
# /health returns {"status":"ok"} and the register phase builds a real
# apply_actions with proof data against it. This file said the endpoint was
# unpublished until 31 August, which was wrong - see docs/what-mainnet-says.md
# for how that error was found and why its direction matters.
PROVING_SERVICE_URL=https://transaction-prover.alpha-mainnet.sw-dev.io

# Note discovery. The SDK cannot resolve which notes an account owns without it,
# and the shadow-account flow fails at `discoverChannels` when it is missing.
# Public alpha infrastructure. It receives the viewing key in cleartext, so this
# must be https and the account pointed at it should be one you would not mind
# an operator being able to read.
INDEXER_URL=https://discovery-service.alpha-mainnet.sw-dev.io

# The deployed shadow-account anonymizer, required by `mainnet.mjs shadow`.
# Verified rather than copied: get_class_hash_at returns
# 0x7ffaf4f427c8de0ca35d32d44d97a31da3c24641e32b72f340660d5b9e7f5e6 and
# get_privacy_contract() on it returns the pool above, so it is bound to the
# same pool the router runs against. starknet.js documents it under "Address of
# a shadow account"; it is in none of the places this project looked first.
SHADOW_ACCOUNT_ANONYMIZER=0x04f33230dc57855c6e7eabe66dfa0fde82c5458fd0e54827cdb7cb4c474888a7
# Running your own discovery service instead? prover/README.md brings one up in a
# container; point INDEXER_URL above at it rather than adding a second line here.
# There were two INDEXER_URL lines until 4 September and the second was empty, so
# copying this file gave you the `TypeError` the first line exists to prevent.
# Stake a ballot escrows, in wei. Defaults to 0.1 STRK.
BALLOT_AMOUNT=
