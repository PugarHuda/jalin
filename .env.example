# Copy to .env and fill in. Never commit the real file - .gitignore covers it.

# Starknet mainnet. Free key at https://www.alchemy.com
# Versioned path: the default /v2/<key> serves RPC 0.8.1, which sncast rejects.
STARKNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_10/YOUR_ALCHEMY_KEY

# The STRK20 pool on mainnet.
POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# Deployer. Needs enough STRK for two declares and two deploys.
ACCOUNT_ADDRESS=
ACCOUNT_PRIVATE_KEY=
ACCOUNT_TYPE=oz

# Governance. BALLOT_TOKEN is what a vote is denominated in; on mainnet that is
# STRK unless you have a reason for something else.
BALLOT_TOKEN=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
FEE_RECIPIENT=

# Router limits at deploy. Governance can move these afterwards.
MAX_STEPS=8
MAX_CALLDATA=64

# Roughly 8 hours of voting and 2 hours of timelock at mainnet block times.
VOTING_BLOCKS=2000
TIMELOCK_BLOCKS=500
# 1 STRK, in wei.
QUORUM=1000000000000000000

# Written back here by contracts/deploy.sh once the contracts are on chain, and
# read afterwards by every script and by the web app. The app inlines the two
# NEXT_PUBLIC_ copies at build time, which is why playwright.config.ts maps
# these into the build it starts.
ROUTER_ADDRESS=
GOVERNOR_ADDRESS=

# The web app. NEXT_PUBLIC_ values are baked into the client bundle at build
# time, so only put addresses here - never a key.
NEXT_PUBLIC_ROUTER_ADDRESS=
NEXT_PUBLIC_GOVERNOR_ADDRESS=
# Absolute origin, used for the Open Graph card, robots.txt and sitemap.xml.
# Defaults to the deployed site when unset.
NEXT_PUBLIC_SITE_URL=https://jalin-five.vercel.app

# scripts/mainnet.mjs only. The proving service is unpublished for mainnet, so
# every phase of that script stops here - see docs/what-mainnet-says.md.
PROVING_SERVICE_URL=
# Your own discovery service, if you are running one: prover/README.md brings it
# up in a container. Unset means the SDK's default provider.
INDEXER_URL=
# Stake a ballot escrows, in wei. Defaults to 0.1 STRK.
BALLOT_AMOUNT=
