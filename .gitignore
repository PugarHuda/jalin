node_modules/
# One workspace, one lockfile. app/ had its own with 439 packages against the
# root's 434, so `npm ci` in that directory resolved a different tree than the
# one CI and Vercel build from.
app/package-lock.json
.env
.env.*
!.env.example
target/
.snfoundry_cache/
dist/
.next/
out/
# Agent skill packs: vendored copies of StarkWare's own documentation, kept
# locally for offline reference. Not this project's source, and .claude/skills
# is only a set of symlinks into .agents, so tracking one and ignoring the other
# put 284K of somebody else's docs in the history under a broken indirection.
.agents/
.claude/
.DS_Store
*.log

.vercel
contracts/snfoundry.toml
vendor/

# Playwright
test-results/
playwright-report/

# Cairo coverage output
contracts/coverage/
contracts/snfoundry_trace/

# built SDK, produced by npm run build -w jalin-sdk on publish
sdk/dist/

# Demo video intermediates. The finished film ships from app/public; the clips,
# the per-scene audio and the ffmpeg build directory are 69 MB of things that
# regenerate from tts.py, record-demo.mjs and compose.py in that order.
scripts/demo-video/audio/
scripts/demo-video/build/
scripts/demo-video/clips/
scripts/demo-video/jalin-demo.mp4
